# Names only; put real values in a gitignored .env. Never commit keys.
# lightwalletd (default https://testnet.zec.rocks:443) and the scan binary
PQI_LWD_URL=
PQI_SCAN_BIN=
PQI_ZINGO_CLI=
# desk server: live (run state with keys and wallets) or published record (read-only)
PQI_STATE=
PQI_PUBLISHED=
PQI_PORT=
# MCP: desk URL, the agent's identity file (only for submit_intent), call log
PQI_DESK_URL=
PQI_AGENT_FILE=
PQI_MCP_LOG=
# examples (live run)
PQI_FUNDER_WALLET=
