{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "paths": { "@pqi/protocol": ["../protocol/src/index.ts"], "@deployments/*": ["../../deployments/*"], "@fixtures/*": ["../../deployments/*"] }
  },
  "include": ["src"]
}
